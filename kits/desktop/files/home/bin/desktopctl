#!/usr/bin/env bash
# desktopctl status | url | resize WxH | log
#
# STATUS PROBES THE PORTS, NOT THE SUPERVISOR.  A live supervisor with a dead
# VNC server still serves the noVNC page -- websockify is what serves it -- so
# the only symptom is the browser saying "Failed to connect to server" while
# everything else reports healthy.  Under TigerVNC 5900 and the X display live
# or die together, which makes that split much less likely than it was under
# Xvfb+x11vnc; the probe stays because websockify is still a separate process
# that outlives the display it forwards.
set -uo pipefail

: "${DISPLAY:=:1}"
: "${NOVNC_PORT:=6080}"
# export, not just assign: `sbx exec` runs no login shell, so DISPLAY may not be
# in the environment at all, and `: "${DISPLAY:=:1}"` alone would leave it a
# shell variable that xdpyinfo and xrandr below never see.
export DISPLAY
STATE="${DESKTOP_STATE:-$HOME/.local/state/desktop}"
TOKEN_FILE=${SBX_TOKEN_FILE:-$HOME/.sbx-token}

port_open() { timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null; }

case "${1:-status}" in
status)
    vnc=stopped; novnc=stopped
    port_open 5900 && vnc=running
    port_open "$NOVNC_PORT" && novnc=running
    printf '%-12s %s\n' Xvnc:5900 "$vnc"
    printf '%-12s %s\n' "noVNC:$NOVNC_PORT" "$novnc"
    if [[ $vnc == running ]]; then
        size=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2}')
        [[ -n $size ]] && printf '%-12s %s\n' "$DISPLAY" "$size"
    fi
    if [[ $vnc == stopped && $novnc == running ]]; then
        echo
        echo "DEGRADED: the page will load and then fail to connect."
        echo "  Look at the log:  desktopctl log"
    fi
    ;;
url)
    if [[ -s "$TOKEN_FILE" ]]; then
        # resize=remote is what makes the desktop follow the browser window
        # instead of being letterboxed or scaled.  It is a noVNC SETTING, saved
        # per-browser in localStorage, so handing out the URL with the
        # parameter already on it is the difference between "it just fits" and
        # "dig through the sidebar on every new machine".
        #
        # Only the first 8 characters of the password matter -- the RFB protocol
        # truncates it and discards the rest.  Printing the whole token here
        # would invite someone to wonder why a 24-character secret "works" when
        # mistyped past the 8th.
        echo "http://127.0.0.1:$NOVNC_PORT/vnc.html?resize=remote    password: $(cut -c1-8 "$TOKEN_FILE")"
    else
        echo "no token file at $TOKEN_FILE" >&2; exit 1
    fi
    ;;
resize)
    # For when nothing is attached to drive the size: a GUI the agent started
    # headlessly, a screenshot that has to come out at a known geometry, a
    # native viewer that does not speak SetDesktopSize.  A connected noVNC
    # session will follow this change; it may also override it on reconnect,
    # which is correct -- the viewer wins when there is a viewer.
    geom=${2:-}
    if [[ ! $geom =~ ^([0-9]+)x([0-9]+)$ ]]; then
        echo "usage: desktopctl resize WIDTHxHEIGHT   (e.g. desktopctl resize 2560x1440)" >&2
        exit 1
    fi
    w=${BASH_REMATCH[1]}; h=${BASH_REMATCH[2]}
    out=$(xrandr 2>/dev/null | awk '/ connected/ {print $1; exit}')
    if [[ -z $out ]]; then
        echo "no connected RandR output on $DISPLAY -- is the desktop running?" >&2
        exit 1
    fi
    # Xvnc reports a RandR maximum of 32768x32768, but it still only PRESETS a
    # dozen or so modes, so an arbitrary size has to be created before it can be
    # selected -- and xrandr will not create one without a well-formed modeline.
    #
    # THE TIMINGS BELOW ARE DELIBERATE NONSENSE.  A pixel clock and sync
    # porches mean nothing to a virtual display; the only thing that has to hold
    # is xrandr's own ordering check (hdisp <= hsyncstart <= hsyncend <= htotal,
    # and the same vertically), which +1/+2/+3 satisfies.  The obvious way to
    # write this is `cvt "$w" "$h"` -- DO NOT.  Neither cvt nor gtf is installed:
    # on Ubuntu 26.04 both ship in xserver-xorg-core, and this kit has no Xorg
    # in it at all.  Reaching for cvt here means either a broken `resize` or a
    # whole X server pulled in to generate four numbers nothing reads.
    name="${w}x${h}"
    # Both of these fail harmlessly when the mode already exists -- the normal
    # case on a repeat resize, and also when the requested size collides with
    # one of Xvnc's presets.
    xrandr --newmode "$name" 100.00 \
        "$w" "$((w + 1))" "$((w + 2))" "$((w + 3))" \
        "$h" "$((h + 1))" "$((h + 2))" "$((h + 3))" -hsync +vsync 2>/dev/null || true
    xrandr --addmode "$out" "$name" 2>/dev/null || true
    if ! xrandr --output "$out" --mode "$name" 2>&1; then
        echo "resize to ${w}x${h} failed" >&2; exit 1
    fi
    echo "$out -> $(xdpyinfo | awk '/dimensions:/ {print $2}')"
    ;;
log)
    # The startup dispatcher owns this service's stdout; these are the component
    # FIFOs it multiplexes, which is the best this can do without a log file.
    echo "desktop output goes to the sandbox startup log; component FIFOs are in $STATE" >&2
    ls -l "$STATE" 2>/dev/null
    ;;
*)
    echo "usage: desktopctl {status|url|resize WxH|log}" >&2; exit 1
    ;;
esac
